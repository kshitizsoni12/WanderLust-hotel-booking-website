<% layout("/layouts/boilerplate.ejs") %>
    <!-- functionality for search -->
    <% if (q) { %>
        <p class="search-summary">
            <strong><%= allListings.length %></strong> result<%= allListings.length === 1 ? "" : "s" %>
            for "<%= q %>"
            <a href="/listings">Clear search</a>
        </p>
    <% } %>

    <% if (allListings.length === 0) { %>
        <div class="empty-state">
            <i class="fa-regular fa-face-frown"></i>
            <h5>No listings found</h5>
            <p>Try a different city, country or title.</p>
            <a href="/listings" class="show-route-btn show-route-viewall-btn d-inline-block" style="width:auto">View all listings</a>
        </div>
    <% } %>


    <!-- actual content -->
    <body>
        <div class="index-route-cards">
            <%for(let listing of allListings){%>
                <a class="listing-link" href="/listings/<%=listing._id%>">
                    <div class="card">
                        <img src="<%=listing.image.url%>" class="card-img-top">
                        <div class="card-body">
                            <h5 class="card-title">
                                <%=listing.title%>
                            </h5>
                            <p class="card-text">
                                &#8377;<%=listing.price.toLocaleString("en-IN")%> / night</p>

                        </div>
                    </div>
                </a>

                <%}%>
        </div>
    </body>