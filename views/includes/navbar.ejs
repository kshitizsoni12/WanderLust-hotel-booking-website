            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">

            <!-- Search: submits to /listings?q=... from any page -->
            <form class="wl-search mx-lg-auto my-3 my-lg-0" action="/listings" method="GET" role="search">
                <i class="fa-solid fa-magnifying-glass wl-search-icon"></i>
                <input type="search" name="q" maxlength="50" autocomplete="off"
                    placeholder="Search by title, city or country"
                    value="<%= locals.q || '' %>" aria-label="Search listings">
                <button type="submit" class="wl-search-btn">Search</button>
            </form>

            <ul class="navbar-nav align-items-lg-center">
                <li class="nav-item">
                    <a class="nav-link wl-link" href="/listings/new">
                        <i class="fa-solid fa-plus me-1"></i>Add new Listing
                    </a>
                </li>

                <% if (!currentUser) { %>
                    <li class="nav-item">
                        <a class="nav-link wl-link" href="/login">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link wl-btn-primary" href="/signup">Sign up</a>
                    </li>
                <% } else { %>
                    <li class="nav-item dropdown">
